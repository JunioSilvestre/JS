{
  "name": "js",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "spellcheck": "cspell \"**/*.{ts,tsx,js,json,md}\"",
    "lt:start": "java -cp ~/tools/languagetool/languagetool-server.jar org.languagetool.server.HTTPServer --port 8010 --allow-origin \"http://localhost:3000\"",
    "test:prepare": "npx tsc --noEmit && npm run lint --silent && NEXT_TELEMETRY_DISABLED=1 next build",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:all": "npm run test:prepare && npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^0.475.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "cspell": "^10.3.6",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "braces": "^3.0.3"
  }
}
